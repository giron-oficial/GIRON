# Copie para .env e preencha (o .env NUNCA vai pro GitHub)
# Endereço do Supabase (teste: domínio oficial)
VITE_SUPABASE_URL=https://teste.gironga.com.br
# Chave pública (anon) do Supabase — pegar no .env da VPS (ANON_KEY)
VITE_SUPABASE_ANON_KEY=

# PostHog (analytics). Chave do projeto (começa com phc_) — pegar em Settings > Project no site do PostHog, região US.
# Se ficar vazio, o analytics simplesmente não liga.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
